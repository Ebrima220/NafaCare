# Server-only. Never prefix this with VITE_ — Vite would ship it to the browser.
# Local: copy this file to .env and paste your key.
# Vercel: Project → Settings → Environment Variables → GEMINI_API_KEY, then redeploy.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Unset uses gemini-2.5-flash with thinking turned off.
# Do not point this at a Pro model — those are much slower.
# GEMINI_MODEL=gemini-2.5-flash
